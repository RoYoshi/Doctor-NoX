#!/usr/bin/python3 -I
"""Doctor NoX launcher for the RPM layout (/usr/share/doctor-nox) and source checkouts.

pip, pipx, Debian and Arch installs use the `doctor-nox` entry point instead;
both run doctor_nox.cli.main.
"""
from pathlib import Path
import sys

# The RPM's private package directory first; then a source checkout (bin/ next to doctor_nox/).
for candidate in ("/usr/share/doctor-nox", str(Path(__file__).resolve().parents[1])):
    if Path(candidate, "doctor_nox").is_dir():
        sys.path.insert(0, candidate)
        break

from doctor_nox.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
